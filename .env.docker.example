# Copie para .env.docker (docker/scripts/up.sh faz isso sozinho e gera os segredos __GERAR__).
# NUNCA commite o .env.docker. Nenhum valor real aqui.

# ---------- Aplicacao ----------
APP_NAME=frete-hub
# mock exige APP_ENV != production. Em producao: APP_ENV=production e TRANSPORTADORAS_MODO=real.
APP_ENV=local
APP_KEY=__GERAR__
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
# Rotacao do APP_KEY: mover a chave antiga para APP_PREVIOUS_KEYS (lista separada por virgula) antes de trocar APP_KEY.
APP_PREVIOUS_KEYS=
LOG_CHANNEL=stderr
LOG_LEVEL=info
# Onde a API fica disponivel no servidor. Por padrao so o proprio servidor acessa (127.0.0.1).
# Para acessar de outra maquina (ex.: Postman), use 0.0.0.0. Em producao, quem expoe e o ALB.
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=8090
# Limite de memoria dos containers de app (o pool do php-fpm foi dimensionado para ~1 GB).
APP_MEMORY=1g
# CIDR(s) do ALB, separados por virgula. Vazio = nao confia em X-Forwarded-*.
TRUSTED_PROXIES=

# ---------- Postgres (container simulando Supabase) ----------
POSTGRES_DB=frete
POSTGRES_USER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=__GERAR__
DB_CONNECTION=pgsql
DB_HOST=frete-postgres
DB_PORT=5432
DB_DATABASE=frete
# Role do runtime (so DML)
DB_USERNAME=frete_app
DB_PASSWORD=__GERAR__
# Role dona do schema (DDL), usada so por docker/scripts/migrate.sh
DB_MIGRATION_USERNAME=frete_migrator
DB_MIGRATION_PASSWORD=__GERAR__
DB_SSLMODE=prefer
# 1 = cria tambem o banco frete_test (usado por docker/scripts/test.sh). Nao use em producao.
CRIAR_BANCO_TESTE=1

# ---------- Administracao ----------
# Token das rotas /api/v1/admin/... (cadastro de clientes e donos). Quem tem este token cria e desabilita clientes:
# e mais poderoso que uma chave de API. Guarde como senha (em producao: Secrets Manager). Para trocar: gere outro com `openssl rand -hex 32`.
ADMIN_API_TOKEN=__GERAR__

# ---------- Redis ----------
REDIS_CLIENT=phpredis
REDIS_HOST=frete-redis
REDIS_PORT=6379
REDIS_PASSWORD=__GERAR__
QUEUE_CONNECTION=sync
CACHE_STORE=redis
CACHE_PREFIX=frete_

# ---------- Sessao do portal (login com e-mail e senha) ----------
# Fica no Redis. Com "array" o login NAO persiste (a chamada seguinte volta 401).
SESSION_DRIVER=redis
# Minutos sem uso ate a sessao expirar
SESSION_LIFETIME=120
# Cookie HttpOnly + SameSite=Strict (o portal deve estar no mesmo dominio registravel do hub, ex.: portal.x.com.br e hub.x.com.br).
# Secure (so HTTPS) liga sozinho com APP_ENV=production.
SESSION_SAME_SITE=strict

# ---------- Armazenamento de etiquetas ----------
FILESYSTEM_DISK=local

# ---------- Seguranca / limites (opcionais; valores padrao em config/frete.php) ----------
# Origens CORS permitidas (vazio = nenhuma). Portal em outro dominio: a origem EXATA, ex.: https://portal.exemplo.com.br
CORS_ALLOWED_ORIGINS=
# true = o navegador pode enviar o cookie de sessao do portal na chamada entre dominios (so com CORS_ALLOWED_ORIGINS preenchido)
CORS_SUPPORTS_CREDENTIALS=false
# Requisicoes por minuto, por cliente
LIMITE_COTACOES_MIN=120
LIMITE_REMESSAS_MIN=30
LIMITE_CONSULTAS_MIN=300
LIMITE_CADASTROS_MIN=60
# Tentativas de login do portal por minuto (por e-mail + IP)
LIMITE_LOGIN_MIN=5
# Consultas por minuto, por usuario, de "ver credenciais da transportadora por inteiro" no portal (acima: 429)
LIMITE_REVELAR_MIN=5
# Falhas de autenticacao por IP em 5 min antes de 429
LIMITE_AUTH_FALHAS_IP=10
# Retencao de dados brutos (dias)
RETENCAO_CHAMADAS_DIAS=30

# ---------- Transportadoras ----------
# mock | real
TRANSPORTADORAS_MODO=mock
# Consulta de CEP: real = ViaCEP de verdade (padrao); mock = endereco de exemplo (so para testes)
VIACEP_MODO=real
