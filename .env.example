# Desenvolvimento fora do Docker dos scripts. Para subir pelos containers use .env.docker (ver .env.docker.example).
APP_NAME=frete-hub
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Banco (Postgres). DB_MIGRATION_* = role dona do schema (so para `migrate`).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=frete
DB_USERNAME=frete_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=frete_migrator
DB_MIGRATION_PASSWORD=
DB_SSLMODE=prefer

# Redis: fila, cache, circuit breaker, rate limit, locks
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=sync
CACHE_STORE=redis
CACHE_PREFIX=frete_

# Sessao do portal (login com e-mail e senha): fica no Redis. Com "array" o login NAO persiste.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie do portal: HttpOnly sempre; SameSite=Strict (o portal deve estar no mesmo dominio registravel do hub);
# Secure sozinho com APP_ENV=production.
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Token das rotas /api/v1/admin/... (cadastro de clientes e donos). Gere com: openssl rand -hex 32. Vazio ou < 32 caracteres = desligado.
ADMIN_API_TOKEN=

# Proxies confiaveis (CIDR do ALB, separados por virgula). Vazio = nao confia em ninguem.
TRUSTED_PROXIES=

# mock | real  (mock e proibido com APP_ENV=production)
TRANSPORTADORAS_MODO=mock

# Portal em outro dominio: origem exata (https://portal.exemplo.com.br) e true para o navegador enviar o cookie.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# Tentativas de login por minuto (por e-mail + IP)
LIMITE_LOGIN_MIN=5
# Consultas por minuto, por usuario, de "ver credenciais da transportadora por inteiro" no portal (acima: 429)
LIMITE_REVELAR_MIN=5
