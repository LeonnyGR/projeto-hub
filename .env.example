# Desenvolvimento fora do Docker dos scripts. Para subir pelos containers use .env.docker (ver .env.docker.example).
APP_NAME=frete-hub
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Banco (Postgres). DB_MIGRATION_* = role dona do schema (so para `migrate`).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=frete
DB_USERNAME=frete_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=frete_migrator
DB_MIGRATION_PASSWORD=
DB_SSLMODE=prefer

# Redis: fila, cache, circuit breaker, rate limit, locks
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=sync
CACHE_STORE=redis
CACHE_PREFIX=frete_

# Sem sessao/cookies: API stateless
SESSION_DRIVER=array

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Proxies confiaveis (CIDR do ALB, separados por virgula). Vazio = nao confia em ninguem.
TRUSTED_PROXIES=

# mock | real  (mock e proibido com APP_ENV=production)
TRANSPORTADORAS_MODO=mock
